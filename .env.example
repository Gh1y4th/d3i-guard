# Postgres connection string (Render provides this automatically if using render.yaml)
DATABASE_URL=postgres://user:pass@localhost:5432/qr_url_guard

# Optional but strongly recommended — get a free key at:
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional but strongly recommended — get a free key at:
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

PORT=3000
